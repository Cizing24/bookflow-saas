DATABASE_URL="postgresql://bookflow:bookflow_dev@127.0.0.1:5433/bookflow?schema=public"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Email: use preview only for local development; never claim preview was sent.
# EMAIL_PROVIDER=preview
# Production HTTP gateway (configure via platform Secrets):
# EMAIL_PROVIDER=http
# EMAIL_HTTP_URL=https://your-mail-gateway.example/send
# EMAIL_HTTP_TOKEN=
# EMAIL_FROM=
# Enable only when a trusted proxy overwrites X-Real-IP and direct origin access is blocked.
TRUST_PROXY_IP=false
