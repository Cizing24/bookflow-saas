generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model User {
  id            String         @id
  name          String
  email         String         @unique
  emailVerified Boolean        @default(false)
  image         String?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]
  platformAdmin PlatformAdmin?
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model Tenant {
  id                      String         @id @default(cuid())
  name                    String
  slug                    String         @unique
  active                  Boolean        @default(true)
  timezone                String         @default("Asia/Taipei")
  minNoticeMinutes        Int            @default(0)
  maxAdvanceDays          Int            @default(90)
  slotIntervalMinutes     Int            @default(30)
  cancelCutoffMinutes     Int            @default(1440)
  rescheduleCutoffMinutes Int            @default(1440)
  createdAt               DateTime       @default(now()) @db.Timestamptz(3)
  memberships             Membership[]
  services                Service[]
  staff                   Staff[]
  customers               Customer[]
  bookings                Booking[]
  hours                   BusinessHour[]
}

model Membership {
  id       String  @id @default(cuid())
  tenantId String
  userId   String
  role     Role    @default(STAFF)
  staffId  String?
  staff    Staff?  @relation(fields: [tenantId, staffId], references: [tenantId, id])
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@unique([tenantId, staffId])
  @@index([userId])
}

model Service {
  id                  String         @id @default(cuid())
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  price               Int
  durationMinutes     Int
  bufferBeforeMinutes Int            @default(0)
  bufferAfterMinutes  Int            @default(0)
  staffServices       StaffService[]
  active              Boolean        @default(true)
  bookings            Booking[]

  @@unique([tenantId, id])
}

model Staff {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  active         Boolean         @default(true)
  memberships    Membership[]
  bookings       Booking[]
  customSchedule Boolean         @default(false)
  schedule       StaffSchedule[]
  absences       StaffAbsence[]
  services       StaffService[]

  @@unique([tenantId, id])
}

model Customer {
  id       String    @id @default(cuid())
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  email    String
  phone    String
  bookings Booking[]

  @@unique([tenantId, id])
  @@index([tenantId, email])
}

model Booking {
  id                  String         @id @default(cuid())
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceId           String
  service             Service        @relation(fields: [tenantId, serviceId], references: [tenantId, id])
  staffId             String
  staff               Staff          @relation(fields: [tenantId, staffId], references: [tenantId, id])
  customerId          String
  customer            Customer       @relation(fields: [tenantId, customerId], references: [tenantId, id])
  startAt             DateTime       @db.Timestamptz(3)
  endAt               DateTime       @db.Timestamptz(3)
  status              BookingStatus  @default(CONFIRMED)
  bufferBeforeMinutes Int            @default(0)
  bufferAfterMinutes  Int            @default(0)
  occupiedStartAt     DateTime?      @db.Timestamptz(3)
  occupiedEndAt       DateTime?      @db.Timestamptz(3)
  idempotencyKey      String?
  requestHash         String?
  managementTokenHash String?        @unique
  revision            Int            @default(0)
  events              BookingEvent[]
  notifications       Notification[]
  serviceName         String
  price               Int
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, startAt])
  @@index([tenantId, staffId, startAt])
}

model BusinessHour {
  id          String @id @default(cuid())
  tenantId    String
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  weekday     Int
  openMinute  Int
  closeMinute Int

  @@unique([tenantId, weekday])
}

model StaffService {
  tenantId  String
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)
  service   Service @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, staffId, serviceId])
}

model StaffSchedule {
  id          String @id @default(cuid())
  tenantId    String
  staffId     String
  staff       Staff  @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)
  weekday     Int
  openMinute  Int
  closeMinute Int
  kind        String @default("WORK")

  @@index([tenantId, staffId])
}

model StaffAbsence {
  id          String @id @default(cuid())
  tenantId    String
  staffId     String
  staff       Staff  @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)
  date        String @db.VarChar(10)
  openMinute  Int    @default(0)
  closeMinute Int    @default(1440)
  reason      String @default("")

  @@index([tenantId, staffId, date])
}

model BookingEvent {
  id        String   @id @default(cuid())
  tenantId  String
  bookingId String
  booking   Booking  @relation(fields: [tenantId, bookingId], references: [tenantId, id], onDelete: Cascade)
  actor     String
  action    String
  before    Json?
  after     Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, bookingId, createdAt])
}

model Notification {
  id          String    @id @default(cuid())
  tenantId    String
  bookingId   String
  booking     Booking   @relation(fields: [tenantId, bookingId], references: [tenantId, id], onDelete: Cascade)
  kind        String
  revision    Int
  recipient   String
  subject     String
  body        String
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @db.Timestamptz(3)
  leaseUntil  DateTime? @db.Timestamptz(3)
  leaseToken  String?
  lastError   String?
  sentAt      DateTime? @db.Timestamptz(3)

  @@unique([bookingId, kind, revision])
  @@index([status, availableAt])
}

model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime @db.Timestamptz(3)
}

model PlatformAdmin {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlatformEvent {
  id        String   @id @default(cuid())
  actorId   String
  tenantId  String?
  action    String
  reason    String
  before    Boolean?
  after     Boolean?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
}
