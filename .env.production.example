# Copy to .env.production on the deployment host; never commit actual values.
DATABASE_URL=postgresql://runtime:REPLACE@db.example:5432/bookflow?sslmode=verify-full
BETTER_AUTH_URL=https://booking.example.com
BETTER_AUTH_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_32_OR_MORE_CHARACTERS
TRUST_PROXY_IP=false
EMAIL_PROVIDER=http
EMAIL_HTTP_URL=https://mail-gateway.example/send
EMAIL_HTTP_TOKEN=REPLACE
EMAIL_FROM=booking@example.com
