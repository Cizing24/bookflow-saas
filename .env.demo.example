NODE_ENV=production
DEPLOYMENT_ENV=public-demo
DATABASE_URL=postgresql://RUNTIME_ROLE:REPLACE_WITH_SECRET@DB_HOST/bookflow_demo?sslmode=verify-full
BETTER_AUTH_URL=https://REPLACE_WITH_ASSIGNED_HOST
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TRUST_PROXY_IP=false
# Do not configure an Email Gateway; the public-demo guard refuses all delivery.
EMAIL_PROVIDER=disabled
# One-time CLI only; inject a different migrator DATABASE_URL.
DEMO_DATABASE_HOST=REPLACE_WITH_DB_HOST
DEMO_PROVISION_CONFIRM=CREATE_SYNTHETIC_DEMO
DEMO_OWNER_PASSWORD=REPLACE_WITH_PRIVATE_RANDOM_PASSWORD_AT_LEAST_24_CHARACTERS
